{
  "name": "flower-shop-cloudflare",
  "version": "1.0.0",
  "description": "Website thương mại điện tử Hoa Tươi - Cloudflare Workers, D1 Database, KV Storage, R2 Object Storage & Gemini AI Chatbot",
  "main": "backend/src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create flower_shop_db",
    "d1:migrate:local": "wrangler d1 execute flower_shop_db --local --file=./backend/src/db/schema.sql",
    "d1:seed:local": "wrangler d1 execute flower_shop_db --local --file=./backend/src/db/seed.sql",
    "d1:init:local": "wrangler d1 execute flower_shop_db --local --file=./backend/src/db/schema.sql && wrangler d1 execute flower_shop_db --local --file=./backend/src/db/seed.sql",
    "d1:migrate:remote": "wrangler d1 execute flower_shop_db --remote --file=./backend/src/db/schema.sql",
    "d1:seed:remote": "wrangler d1 execute flower_shop_db --remote --file=./backend/src/db/seed.sql",
    "kv:create": "wrangler kv namespace create FLOWER_SHOP_KV",
    "r2:create": "wrangler r2 bucket create flower-shop-bucket",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.152.0"
  }
}
