[VERIFICATION_QUERY_BASIN_CATALOG]
-- Truy vấn kiểm tra dữ liệu trên Basin Catalog (Apache Iceberg)
SELECT * 
FROM default.visitors 
WHERE id = 'Nhóm 07 CNTTK22L' 
ORDER BY _ingest_ts DESC 
LIMIT 50;

-- Thống kê tổng số lượt truy cập trong 24 giờ qua:
SELECT COUNT(*) AS total_visits 
FROM default.visitors 
WHERE id = 'Nhóm 07 CNTTK22L' 
  AND _ingest_ts >= NOW() - INTERVAL 24 HOUR;

-- Thống kê theo Quốc gia:
SELECT country, COUNT(*) AS visits 
FROM default.visitors 
WHERE id = 'Nhóm 07 CNTTK22L' 
  AND _ingest_ts >= NOW() - INTERVAL 24 HOUR 
GROUP BY country 
ORDER BY visits DESC;

-- Thống kê theo Loại thiết bị:
SELECT device, COUNT(*) AS visits 
FROM default.visitors 
WHERE id = 'Nhóm 07 CNTTK22L' 
  AND _ingest_ts >= NOW() - INTERVAL 24 HOUR 
GROUP BY device 
ORDER BY visits DESC;
