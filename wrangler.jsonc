{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flower-shop-cloudflare",
  "account_id": "701ece81cedd7db4bf1eb764825c6781",
  "main": "backend/src/index.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "flower-shop-index"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flower_shop_db",
      "database_id": "6104d683-ae9f-4915-84b9-770c795003f4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "158758169aee453e851f5703669a4ab9"
    }
  ],
  "vars": {
    "APP_NAME": "FlowerShop - Tiệm Hoa Tươi Trực Tuyến",
    "VIETQR_BANK_ID": "MB",
    "VIETQR_ACCOUNT_NO": "0362843621",
    "VIETQR_ACCOUNT_NAME": "NGUYEN DAC HOANG",
    "BASIN_ACCOUNT_ID": "de1d7518f067890180f66ad877cb6b2c",
    "BASIN_INGEST_ENDPOINT": "https://f8fb6f6f730b404fb2f273fd789d04df.ingest.cloudflare.com",
    "BASIN_BUCKET": "visitors",
    "BASIN_NAMESPACE": "default",
    "BASIN_TABLE": "visitors",
    "R2_ACCOUNT_ID": "de1d7518f067890180f66ad877cb6b2c",
    "R2_BUCKET": "visitors",
    "R2_ACCESS_KEY_ID": "987ecfb4cc6819e35a2f8581955e7e64",
    "R2_SECRET_ACCESS_KEY": "1abbbc86bf0b7fafb94f74ba40e9a9b768b4ba295e92f9d0866c33fffe9acebf"
  }
}
