{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flower-shop-cloudflare",
  "main": "backend/src/index.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flower_shop_db",
      "database_id": "6104d683-ae9f-4915-84b9-770c795003f4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "158758169aee453e851f5703669a4ab9"
    }
  ],
  "vars": {
    "APP_NAME": "FlowerShop - Tiệm Hoa Tươi Trực Tuyến",
    "VIETQR_BANK_ID": "MB",
    "VIETQR_ACCOUNT_NO": "0362843621",
    "VIETQR_ACCOUNT_NAME": "NGUYEN DAC HOANG"
  }
}
